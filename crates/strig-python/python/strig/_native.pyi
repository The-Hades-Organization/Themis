"""Type stubs of the native extension. Values are plain JSON (`dict`, `list`, `str`, `int`, `float`,
`bool`, `None`) with the same camelCase field names as the JavaScript API."""

from typing import Any, Callable, Dict, Iterable, List, Mapping, Optional, Sequence

Json = Any
JsonObject = Dict[str, Any]
Request = Mapping[str, Any]
Hook = Callable[[Any], Any]

class Context:
    def __init__(
        self,
        grants: Optional[Sequence[Mapping[str, Any]]] = None,
        *,
        tuples: Optional[Sequence[Mapping[str, Any]]] = None,
        env: Optional[Mapping[str, Any]] = None,
        now: Optional[int] = None,
        limits: Optional[Mapping[str, Any]] = None,
    ) -> None: ...
    def set_grants(self, grants: Sequence[Mapping[str, Any]]) -> None: ...
    def add_grant(self, grant: Mapping[str, Any]) -> None: ...
    def remove_grant(self, id: str) -> bool: ...
    def grants(self) -> List[JsonObject]: ...
    @property
    def size(self) -> int: ...
    def __len__(self) -> int: ...
    def add_tuple(self, tuple: Mapping[str, Any]) -> bool: ...
    def remove_tuple(self, tuple: Mapping[str, Any]) -> bool: ...
    def set_env(self, env: Mapping[str, Any]) -> None: ...
    def load_capabilities(self, capabilities: Mapping[str, Any]) -> JsonObject: ...
    def set_now(self, now: Optional[int] = None) -> None: ...
    def set_limits(self, limits: Optional[Mapping[str, Any]] = None) -> None: ...

class Engine:
    def __init__(
        self,
        spec: Mapping[str, Any],
        *,
        conditions: Optional[Mapping[str, Callable[[List[Any]], bool]]] = None,
        overrides: Optional[Iterable[Mapping[str, Any]]] = None,
        invariants: Optional[Mapping[str, Callable[[JsonObject], Any]]] = None,
        audit_sink: Optional[Callable[[JsonObject], None]] = None,
        audit_redact: Optional[Callable[[JsonObject], JsonObject]] = None,
        on_audit_drop: Optional[Callable[[JsonObject], None]] = None,
        audit_policy: Optional[Mapping[str, Any]] = None,
    ) -> None: ...
    def decide(self, context: Context, request: Request, now: Optional[int] = None) -> JsonObject: ...
    def check(self, context: Context, request: Request, now: Optional[int] = None) -> bool: ...
    def explain(self, context: Context, request: Request, now: Optional[int] = None) -> JsonObject: ...
    def why_not(
        self,
        context: Context,
        request: Request,
        now: Optional[int] = None,
        options: Optional[Mapping[str, Any]] = None,
    ) -> Optional[JsonObject]: ...
    def check_many(self, context: Context, requests: Sequence[Request], now: Optional[int] = None) -> List[bool]: ...
    def explain_many(
        self, context: Context, requests: Sequence[Request], now: Optional[int] = None
    ) -> List[JsonObject]: ...
    def capabilities(
        self, context: Context, subject: Mapping[str, Any], scope: Mapping[str, Any], now: Optional[int] = None
    ) -> JsonObject: ...
    def validate_grant(self, grant: Mapping[str, Any]) -> None: ...
    def catalog(self) -> JsonObject: ...
    def apply(self, input: Mapping[str, Any]) -> JsonObject: ...
    def impact(self, input: Mapping[str, Any]) -> JsonObject: ...
    def review_impact(self, input: Mapping[str, Any]) -> JsonObject: ...
    def propose(self, input: Mapping[str, Any]) -> JsonObject: ...
    def resolve(self, input: Mapping[str, Any]) -> JsonObject: ...
    def elevate(self, input: Mapping[str, Any]) -> JsonObject: ...
    def recertify(self, input: Mapping[str, Any]) -> JsonObject: ...
    def expire(self, input: Mapping[str, Any]) -> JsonObject: ...
    def flush_audit(self) -> JsonObject: ...
    def audit_stats(self) -> JsonObject: ...
    def materialize(self, input: Mapping[str, Any]) -> JsonObject: ...
    def apply_template(self, input: Mapping[str, Any]) -> JsonObject: ...
    def list(
        self,
        context: Context,
        subject: Mapping[str, Any],
        permission: str,
        kind: str,
        options: Optional[Mapping[str, Any]] = None,
        now: Optional[int] = None,
    ) -> JsonObject: ...
    def who_can(self, context: Context, permission: str, now: Optional[int] = None) -> List[JsonObject]: ...
    def who_can_on(
        self, context: Context, permission: str, resource: Mapping[str, Any], now: Optional[int] = None
    ) -> JsonObject: ...
    def access_of(
        self, context: Context, resource: Mapping[str, Any], now: Optional[int] = None
    ) -> List[JsonObject]: ...
    def check_for(
        self,
        context: Context,
        subject_ref: Mapping[str, Any],
        permission: str,
        resource: Mapping[str, Any],
        subjects: Sequence[Mapping[str, Any]],
        now: Optional[int] = None,
    ) -> JsonObject: ...

class Exclusive:
    def __init__(self, options: Optional[Mapping[str, Any]] = None) -> None: ...
    def validate(self, engine: Engine) -> None: ...
    def acquire(
        self,
        engine: Engine,
        context: Context,
        subject: Mapping[str, Any],
        resource: Mapping[str, Any],
        terms: Mapping[str, Any],
        now: Optional[int] = None,
    ) -> JsonObject: ...
    def holder(self, resource: Mapping[str, Any], now: Optional[int] = None) -> Optional[JsonObject]: ...
    def release(
        self, resource: Mapping[str, Any], holder: Mapping[str, Any], now: Optional[int] = None
    ) -> JsonObject: ...
    def renew(
        self,
        engine: Engine,
        context: Context,
        subject: Mapping[str, Any],
        resource: Mapping[str, Any],
        ttl_ms: int,
        now: Optional[int] = None,
    ) -> JsonObject: ...
    def expire(self, now: Optional[int] = None) -> List[JsonObject]: ...

def audit_estimate(level: str, records: int) -> float: ...
def verify_audit_chain(records: Sequence[Mapping[str, Any]], anchors: Optional[Mapping[str, Any]] = None) -> JsonObject: ...
def dsl_compile(text: str, options: Optional[Mapping[str, Any]] = None) -> JsonObject: ...
def dsl_print(policy: Mapping[str, Any], language: str) -> JsonObject: ...
def dsl_convert(text: str, language: str) -> JsonObject: ...
def dsl_format(text: str, options: Optional[Mapping[str, Any]] = None) -> JsonObject: ...
def dsl_is_formatted(text: str, options: Optional[Mapping[str, Any]] = None) -> JsonObject: ...
def dsl_load_project(sources: Sequence[Mapping[str, str]]) -> JsonObject: ...
def dsl_load_project_dir(dir: str) -> JsonObject: ...
def dsl_run_tests(policy: Mapping[str, Any], tests: Sequence[Any]) -> JsonObject: ...
